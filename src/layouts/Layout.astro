---
import '../styles/global.css';
import { defaultLang, homePath, languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site!;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link rel="canonical" href={new URL(homePath[lang], site)} />
    {(Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(homePath[l], site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath[defaultLang], site)} />

    {/*
      Only the root page guesses the language: a saved choice wins, otherwise
      the first supported device language. /es/ is never redirected, so a
      shared Spanish link always opens in Spanish.
    */}
    {lang === defaultLang && (
      <script is:inline define:vars={{ paths: homePath, fallback: defaultLang }}>
        let lang = null;
        try { lang = localStorage.getItem('lang'); } catch {}
        if (!(lang in paths)) {
          const prefs = navigator.languages?.length ? navigator.languages : [navigator.language || fallback];
          lang = prefs.map((tag) => tag.toLowerCase().split('-')[0]).find((l) => l in paths) || fallback;
        }
        if (lang !== fallback) location.replace(paths[lang] + location.hash);
      </script>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
