---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { skills } from '../data/portfolio';
import { defaultLang, homePath, languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Overrides the default page title. */
  title?: string;
  /** Pages that shouldn't be indexed (e.g. 404) skip canonical/hreflang. */
  noindex?: boolean;
}

const { lang, title, noindex = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('meta.title');
const site = Astro.site!;

const canonical = new URL(homePath[lang], site).href;
const ogImage = new URL(`/og-${lang}.jpg`, site).href;
const ogLocale = { en: 'en_US', es: 'es_CL' } satisfies Record<Lang, string>;
const langs = Object.keys(languages) as Lang[];

// Structured data: tells search engines this site is about a person, so the
// name, role and profiles can show up in rich results / knowledge panels.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.href}#person`,
      name: 'Diego Godoy',
      alternateName: 'Diego Godoy Martinez',
      jobTitle: t('hero.role'),
      description: t('meta.description'),
      url: site.href,
      image: ogImage,
      email: 'mailto:dgodoy9725@gmail.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Rancagua', addressCountry: 'CL' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'INACAP' },
      knowsAbout: skills,
      knowsLanguage: ['es', 'en'],
      sameAs: ['https://github.com/Izzyll'],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      url: site.href,
      name: 'Diego Godoy',
      inLanguage: langs,
      author: { '@id': `${site.href}#person` },
    },
    {
      '@type': 'ProfilePage',
      url: canonical,
      name: t('meta.title'),
      inLanguage: lang,
      mainEntity: { '@id': `${site.href}#person` },
      isPartOf: { '@id': `${site.href}#website` },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={t('meta.description')} />
    <meta name="author" content="Diego Godoy" />
    <meta name="theme-color" content="#6D4AFF" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {langs.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(homePath[l], site)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL(homePath[defaultLang], site)} />
        <link rel="sitemap" href="/sitemap-index.xml" />
      </>
    )}

    <!-- Social previews (LinkedIn, WhatsApp, Slack, X...) -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Diego Godoy" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.ogAlt')} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={ogLocale[l]} />
    ))}
    <meta property="profile:first_name" content="Diego" />
    <meta property="profile:last_name" content="Godoy" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={t('meta.description')} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/*
      Only the root page guesses the language: a saved choice wins, otherwise
      the first supported device language. /es/ is never redirected, so a
      shared Spanish link always opens in Spanish.
    */}
    {lang === defaultLang && !noindex && (
      <script is:inline define:vars={{ paths: homePath, fallback: defaultLang }}>
        let lang = null;
        try { lang = localStorage.getItem('lang'); } catch {}
        if (!(lang in paths)) {
          const prefs = navigator.languages?.length ? navigator.languages : [navigator.language || fallback];
          lang = prefs.map((tag) => tag.toLowerCase().split('-')[0]).find((l) => l in paths) || fallback;
        }
        if (lang !== fallback) location.replace(paths[lang] + location.hash);
      </script>
    )}

    <!-- Self-hosted fonts; the display face is preloaded because it paints the h1 (LCP). -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <slot />
  </body>
</html>
