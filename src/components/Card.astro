---
interface Props {
  title: string;
  when: string;
  description: string;
  stack: string[];
  links?: { href: string; label: string }[];
}

const { title, when, description, stack, links = [] } = Astro.props;
---

<article class="card">
  <span class="tag"></span>
  <h3>{title}</h3>
  <p class="when">{when}</p>
  <p class="desc">{description}</p>
  <div class="stack">
    {stack.map((tech) => <span class="chip">{tech}</span>)}
  </div>
  {links.length > 0 && (
    <div class="card-links">
      {links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
      ))}
    </div>
  )}
</article>

<style>
  .card {
    background: var(--card); border: var(--border); border-radius: 18px;
    box-shadow: var(--shadow); padding: 22px;
    display: flex; flex-direction: column;
    transition: transform .22s var(--spring), box-shadow .22s var(--spring);
  }
  .card:nth-child(4n+1) { transform: rotate(-1.6deg); }
  .card:nth-child(4n+2) { transform: rotate(1.4deg); }
  .card:nth-child(4n+3) { transform: rotate(1deg); }
  .card:nth-child(4n+4) { transform: rotate(-1.2deg); }
  .card:hover, .card:focus-within {
    transform: rotate(0) translateY(-6px); box-shadow: var(--shadow-lg);
  }

  .tag {
    display: inline-block; width: 44px; height: 8px; border-radius: 999px;
    border: 2px solid var(--ink); margin-bottom: 14px;
  }
  .card:nth-child(4n+1) .tag { background: var(--bubblegum); }
  .card:nth-child(4n+2) .tag { background: var(--sky); }
  .card:nth-child(4n+3) .tag { background: var(--lime); }
  .card:nth-child(4n+4) .tag { background: var(--tangerine); }

  h3 {
    font-family: var(--font-display); font-weight: 600;
    font-size: 1.25rem; margin: 0 0 2px;
  }
  .when {
    font-family: var(--font-mono); font-size: .74rem;
    color: var(--ink-soft); margin: 0 0 12px;
  }
  .desc { margin: 0 0 16px; color: var(--ink-soft); font-size: .95rem; }

  .stack { display: flex; flex-wrap: wrap; gap: 7px; margin-top: auto; }
  .chip {
    font-family: var(--font-mono); font-size: .72rem;
    padding: 4px 9px; border: 2px solid var(--ink);
    border-radius: 7px; background: var(--paper);
  }

  .card-links { display: flex; gap: 16px; margin-top: 14px; }
  .card-links a {
    font-family: var(--font-mono); font-size: .82rem; font-weight: 500;
    text-decoration: none; border-bottom: 2px solid var(--grape); padding-bottom: 1px;
  }
  .card-links a:hover { color: var(--grape); }

  @media (max-width: 760px) {
    .card { transform: none !important; }
  }
</style>
