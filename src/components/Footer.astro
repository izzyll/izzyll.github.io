---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer>
  {t('footer')} ·
  <a href="https://github.com/Izzyll" target="_blank" rel="noopener">Diego Godoy</a>
</footer>

<style>
  footer {
    text-align: center; padding: 50px 0 60px;
    font-family: 'JetBrains Mono', monospace; font-size: .82rem; color: var(--ink-soft);
  }
  a { color: var(--grape); text-decoration: none; }
</style>
